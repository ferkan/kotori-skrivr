[Desktop Entry]
Version=1.0
Type=Application
Name=Kotori Skrivr
GenericName=Text Editor
Comment=A fast, lightweight text editor for Markdown, JSON, and more
Exec=skrivr %F
Icon=skrivr
Terminal=false
Categories=Utility;Development;TextEditor;
Keywords=markdown;editor;text;json;yaml;
MimeType=text/plain;text/markdown;text/x-markdown;application/json;application/x-yaml;application/toml;text/x-toml;
StartupNotify=true
StartupWMClass=skrivr
